# ---------------------------------------------------------------------------
# Life OS — environment variables (placeholders only, never commit real values)
# Copy this file to `.env` and fill in real values for your environment.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma at runtime and for migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://lifeos:lifeos_dev_password@localhost:5432/lifeos_dev?schema=public"

# Separate database used by the integration test suite. Never point this at a
# database that contains real data — the tests truncate tables.
TEST_DATABASE_URL="postgresql://lifeos:lifeos_dev_password@localhost:5432/lifeos_test?schema=public"

# Auth.js (NextAuth v5) secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"

# Public base URL. Set the deployed origin in production.
AUTH_URL="http://localhost:3000"
